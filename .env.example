SIMPLE_SCP_VERSION=latest
SIMPLE_SCP_PORT=8080
SIMPLE_SCP_LISTEN=:8080
SIMPLE_SCP_DATA_DIR=/data
SIMPLE_SCP_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Alternative: SIMPLE_SCP_MASTER_KEY_FILE=/run/secrets/simplescp_master_key
SIMPLE_SCP_ADMIN_USER=admin
SIMPLE_SCP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# Alternative on first boot: SIMPLE_SCP_ADMIN_PASSWORD_FILE=/run/secrets/simplescp_admin_password
SIMPLE_SCP_COOKIE_SECURE=false
SIMPLE_SCP_SESSION_TTL=24h
SIMPLE_SCP_SSH_TIMEOUT=15s
SIMPLE_SCP_MAX_UPLOAD_BYTES=10737418240
SIMPLE_SCP_MAX_CONCURRENT_TRANSFERS=4
SIMPLE_SCP_LOGIN_MAX_ATTEMPTS=5
SIMPLE_SCP_LOGIN_WINDOW=15m
